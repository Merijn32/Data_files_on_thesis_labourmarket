{UTF-8}
Increase in RT policy 0=
	IF THEN ELSE(Time<2031, "already determind retirement age 2020-2030"*yearly trigger \
		, IF THEN ELSE("RT Policy 0: Following current trend Stock"<max retirement age, current retirement trend\
		*yearly trigger , 0 ) )
	~	Dmnl
	~		|

Retirement age policy=
	IF THEN ELSE(Policy Switch Retirement age=0, "RT Policy 0: Following current trend" \
		, IF THEN ELSE ( Policy Switch Retirement age = 1 , "RT Policy 1: ASAP to 75" , IF THEN ELSE\
		 ( Policy Switch Retirement age
	 = 2 , "RT Policy 2: ASAP to 75 with 6 months increase" , IF THEN ELSE( Policy Switch Retirement age\
		 = 3 , "RT Policy 3: Kunduz proposal"
	 , IF THEN ELSE(Policy Switch Retirement age
	=4, "RT Policy 4: Kunduz proposal with 6 months increase" , 0 ) )
	 )
	 )
	)
	~	Year
	~		|

current retirement trend=
	0.0333
	~	Year
	~		|

"RT Policy 0: Following current trend Stock"= INTEG (
	Increase in RT policy 0,
		RT at 2020)
	~	Year
	~		|

"W Policy 3: Wages dependant on LB and Exo. trend"[s industry]=
	"W Policy 2: Wages dependant on labour balance"[s industry]*distribution wages scenario coefficient\
		+"W Policy 1: Wages dependant on exogenous trend"
	[s industry]*(1-distribution wages scenario coefficient) ~~|
"W Policy 3: Wages dependant on LB and Exo. trend"[s service]=
	"W Policy 2: Wages dependant on labour balance"[s service]*distribution wages scenario coefficient\
		+"W Policy 1: Wages dependant on exogenous trend"
[s service]*(1-distribution wages scenario coefficient)
	~	Euro/(FTE*Month*Year)
	~		|

"RT Policy 0: Following current trend"=
	"RT Policy 0: Following current trend Stock"
	~	Year
	~		|

increase in GDP[sectors]=
	IF THEN ELSE(Time<=2024, "fixed GDP 2020-2024"*"Init percentage GDP Industry/Service"\
		[sectors], 
	IF THEN ELSE(Scenario Switch GDP scenario's=1, GDP Scenario 1 exogenous gap[sectors]\
		 , IF THEN ELSE
	(Scenario Switch GDP scenario's
	=2, "GDP Scenario 2: exogenous trend (% times GDP)"[sectors], IF THEN ELSE(Scenario Switch GDP scenario's\
		=3, "GDP Scenario 3: gap above GDP"[sectors] , 0 ) ) 
	) )
	~	Euro/(Year*Year)
	~		|

GDP Scenario 1 exogenous gap[s industry]=
	8e+09 ~~|
GDP Scenario 1 exogenous gap[s service]=
	2.58995e+10
	~	Euro/(Year*Year)
	~		|

Total GDP=
	SUM(GDP[sectors!])
	~	Euro/Year
	~		|

Total potential GDP=
	SUM(potential GDP[sectors!])
	~	Euro/Year
	~		|

GDP[sectors]=
	total workforce in FTE[sectors]*Productivity per sector[sectors]*months per year
	~	Euro/Year
	~		|

init potential GDP per sector[sectors]=
	init potential GDP*"Init percentage GDP Industry/Service"[sectors]
	~	Euro/Year
	~		|

increase in productivity in service[s service]=
	increase in wages[s service]*wages on productivity coefficient+increase in human capital
	[s service]*human capital on productivity coefficient
	~	Euro/(FTE*Month)/Year
	~		|

"fixed GDP 2020-2024"= WITH LOOKUP (
	Time,
		               ([(2020,-6e+09)-(2070,6e+10)],(2020,5.2656e+10),(2021,5.2656e+10),(2021.01\
		,4.4642e+10),(2022,4.4642e+10
		),(2022.01,-5.599e+09),(2023,-5.599e+09),(2023.01,1.0059e+10),(2024,1.0059e+10),(2024.01\
		,0),(2025,0),(2025.01,0),(2070,0
		) ))
	~	Euro/(Year*Year)
	~		|

increase in productivity in industry[s industry]=
	Capital[s industry]*capital on productivity coefficient+increase in technology[s industry\
		]*technology on productivity coefficient
	~	Euro/(FTE*Month)/Year
	~		|

"W Policy 2: Wages dependant on labour balance"[sectors]=
	("Need for labour - relative difference between potential and actual workforce"[sectors\
		]-coefficient to increase the relative effect between sectors
	)*labour balance and wages coefficient
	~	Euro/(FTE*Month*Year)
	~		|

total workforce in person=
	SUM(total workforce per sector in person[sectors!])
	~	person
	~		|

Labour dependency ratio=
	(Total population-total workforce in person)/total workforce in person
	~	Dmnl
	~		|

"increase in potential GDP by % of GDP"=
	0.02
	~	1/Year
	~		|

"GDP Scenario 2: exogenous trend (% times GDP)"[sectors]=
	"increase in potential GDP by % of GDP"*GDP[sectors]
	~	Euro/(Year*Year)
	~		|

dynamic female percentage per sector correction in times of labour surplus[s industry\
		,female working population]=
	IF THEN ELSE(Need for labour Industry<1, 0 , IF THEN ELSE(Need for labour Service>1,\
		 dynamic female percentage per sector per age[female working population,s industry]\
		 , 1 ) ) ~~|
dynamic female percentage per sector correction in times of labour surplus[s service,\
		female working population]=
	IF THEN ELSE(Need for labour Service<1, 0 , IF THEN ELSE(Need for labour Industry>1,\
		 dynamic female percentage per sector per age[female working population,s service] \
		, 1 ) )
	~	Dmnl
	~		|

hiring female[female working population,sectors]=
	MAX(0,
	      dynamic female percentage per sector correction in times of labour surplus[sectors\
		,female working population]
	      * "Preference for workers - relative difference between wages in sectors"[sectors\
		]
	      * (female potential hiring workforce[female working population] / average hiring time for new workforce\
		)
	    )
	~	person/Year
	~		|

hiring female per sector[sectors]=
	SUM(hiring female[female working population!,sectors])
	~	person/Year
	~		|

firing female[female working population,sectors]=
	MAX(Female Workforce[female working population,sectors]/average time working at same job\
		[sectors],female firing due to decrease in labour participation when getting older[\
		female working population,sectors]/delay factor of firing due to decrease in labour participation when getting older\
		)
	~	person/Year
	~		|

firing male[male working population,sectors]=
	MAX(Male workforce[male working population,sectors]/average time working at same job\
		[sectors],male firing due to decrease in labour participation when getting older[male working population\
		,sectors]/delay factor of firing due to decrease in labour participation when getting older\
		)
	~	person/Year
	~		|

dynamic percentage female workforce per sector[sectors]=
	total female workforce per sector[sectors]/total female workforce
	~	Dmnl
	~		|

dynamic percentage male workforce per sector[sectors]=
	total male workforce per sector[sectors]/total male workforce
	~	Dmnl
	~		|

Total labour supply in FTE[sectors]=
	total Average FTE per female*SUM(Available Female labour supply per age[female all!]\
		)*dynamic percentage female workforce per sector[sectors]+total Average FTE per male\
		*SUM(Available Male labour supply per age
	[male working population!])*dynamic percentage male workforce per sector[sectors]
	~	FTE
	~		|

hiring male[male working population,sectors]=
	MAX(0,
	      dynamic male percentage per sector correction in times of labour surplus[sectors\
		, male working population]
	      * "Preference for workers - relative difference between wages in sectors"[sectors\
		]
	      * (male potential hiring workforce[male working population] / average hiring time for new workforce\
		)
	    )
	~	person/Year
	~		|

hiring male per sector[sectors]=
	SUM(hiring male[male working population!,sectors])
	~	person/Year
	~		|

Labour balance[sectors]=
	Total labour supply in FTE[sectors]-labour demand per sector[sectors]
	~	FTE
	~		|

"male relative change working population - deaths and migration"[male working population\
		,sectors]=
	(male deaths[male working population]+male emigration number[male working population\
		])/Male population[male working population
	]
	~	1/Year
	~		|

increase in wages[sectors]=
	IF THEN ELSE(Policy Switch Wages scenario's=1, "W Policy 1: Wages dependant on exogenous trend"\
		[sectors] , IF THEN ELSE
	(Policy Switch Wages scenario's=2, "W Policy 2: Wages dependant on labour balance"[sectors\
		] , IF THEN ELSE(Policy Switch Wages scenario's
	=3, "W Policy 3: Wages dependant on LB and Exo. trend"[sectors] , -1000 ) ) )
	~	Euro/(FTE*Month*Year)
	~		|

dynamic male percentage per sector correction in times of labour surplus[s industry,male working population\
		]=
	IF THEN ELSE(Need for labour Industry<1, 0 , IF THEN ELSE(Need for labour Service>1,\
		 dynamic male percentage per sector per age[male working population,s industry] , 1\
		 ) ) ~~|
dynamic male percentage per sector correction in times of labour surplus[s service,male working population\
		]=
	IF THEN ELSE(Need for labour Service<1, 0 , IF THEN ELSE(Need for labour Industry>1,\
		 dynamic male percentage per sector per age[male working population,s service] , 1 \
		) )
	~	Dmnl
	~		|

Need for labour Service=
	SUM("Need for labour - relative difference between potential and actual workforce"[s service\
		!])
	~	Dmnl
	~		|

coefficient to increase the relative effect between sectors=
	0.85
	~	Dmnl
	~		|

male deaths and net migration in workforce[male working population,sectors]=
	MAX(0,"male relative change working population - deaths and migration"[male working population\
		,sectors]* Male workforce
	[male working population,sectors])
	~	person/Year
	~		|

male firing due to decrease in labour participation when getting older[male working population\
		,sectors]=
	MAX(0,Male workforce[male working population,sectors]*Difference between theoretical and actual labour participation for males
	[male working population])
	~	person
	~		|

Need for labour Industry=
	SUM("Need for labour - relative difference between potential and actual workforce"[s industry\
		!])
	~	Dmnl
	~		|

female firing due to decrease in labour participation when getting older[female working population\
		,sectors]=
	MAX(0,Female Workforce[female working population,sectors]*Difference between theoretical and actual labour participation for females
	[female working population])
	~	person
	~		|

Average wages per sector=
	Sum of wages in sectors/Number of sectors
	~	Euro/(FTE*Month)
	~		|

firing per sector[sectors]=
	SUM (firing female[female working population!,sectors])+SUM (firing male[male working population\
		!,sectors])
	~	person/Year
	~		|

Available Female labour supply per age[female all]=
	Female population[female all]*Female Labour Participation per age[female all]
	~	person
	~		|

"Preference for workers - relative difference between wages in sectors"[s industry]=
	1+(Wages in Industry[s industry]-Average wages per sector)/Sum of wages in sectors ~~|
"Preference for workers - relative difference between wages in sectors"[s service]=
	1+(Wages in Service[s service]-Average wages per sector)/Sum of wages in sectors
	~	Dmnl
	~		|

Actual female labour participation per age[female working population]=
	Female workforce per age[female working population]/Female population[female working population\
		]
	~	Dmnl
	~		|

Actual male labour participation per age[male working population]=
	Male workforce per age[male working population]/Male population[male working population\
		]
	~	Dmnl
	~		|

Number of sectors=
	2
	~	Dmnl
	~		|

hiring per sector[sectors]=
	SUM( hiring female[female working population!,sectors])+SUM( hiring male[male working population\
		!,sectors])
	~	person/Year
	~		|

Sum of wages in sectors=
	SUM(Wages[sectors!])
	~	Euro/(FTE*Month)
	~		|

Difference between theoretical and actual labour participation for females[female working population\
		]=
	MAX(0, Actual female labour participation per age[female working population]-Female Labour Participation per age\
		[female working population])
	~	Dmnl
	~		|

Available Male labour supply per age[male all]=
	Male population[male all]*Male Labour Participation per age[male all]
	~	person
	~		|

total Average FTE per male=
	SUM(Male FTE per age[male all!]*Male population[male all!])/SUM(Male population[male all\
		!])
	~	FTE/person
	~		|

total workforce per sector[sectors]=
	total male workforce per sector[sectors]*total Average FTE per male+total female workforce per sector\
		[sectors]*total Average FTE per female
	~	FTE
	~		|

Male workforce per age[male working population]=
	SUM(Male workforce[male working population,sectors!])
	~	person
	~		|

female emigration number[female all]=
	lookup female emigration(female age groups[female all])
	~	person/Year
	~		|

lookup female emigration(
	[(0,0)-(125,4500)],(0,609),(4.9,609),(5,516),(9.9,516),(10,327),(14.9,327),(15,500),\
		(19.9,500),(20,4223),(24.9,4223),(25,3346),(29.9,3346),(30,1884),(34.9,1884),(35,1079\
		),(39.9,1079),(40,700),(44.9,700),(45,538),(49.9,538),(50,342),(70,342),(75,0),(125\
		,0))
	~	person/Year
	~		|

total workforce in FTE[sectors]=
	total female workforce per sector[sectors]*total Average FTE per female+total male workforce per sector\
		[sectors]*total Average FTE per male
	~	FTE
	~		|

Difference between theoretical and actual labour participation for males[male working population\
		]=
	MAX(0, Actual male labour participation per age[male working population]-Male Labour Participation per age\
		[male working population])
	~	Dmnl
	~		|

"female relative change working population - deaths and migration"[female working population\
		,sectors]=
	(female deaths[female working population]+female emigration number[female working population\
		])/Female population[female working population
	]
	~	1/Year
	~		|

lookup male emigration(
	[(0,0)-(125,4000)],(0,642),(4.9,642),(5,544),(9.9,544),(10,329),(14.9,329),(15,465),\
		(19.9,465),(20,3202),(24.9,3202),(25,3547),(29.9,3547),(30,2459),(34.9,2459),(35,1677\
		),(39.9,1677),(40,1178),(44.9,1178),(45,846),(49.9,846),(50,490),(70,490),(75,0),(125\
		,0))
	~	person/Year
	~		|

female percentage of total workforce=
	SUM(Female Workforce[female working population!,sectors!])/SUM(total workforce per sector in person\
		[sectors!])
	~	Dmnl
	~		|

male emigration number[male all]=
	lookup male emigration(male age groups[male all])
	~	person/Year
	~		|

male percentage of total workforce=
	SUM(Male workforce[male working population!,sectors!])/SUM(total workforce per sector in person\
		[sectors!])
	~	Dmnl
	~		|

delay factor of firing due to decrease in labour participation when getting older=
	0.01
	~	Year
	~		|

Female workforce per age[female working population]=
	SUM(Female Workforce[female working population,sectors!])
	~	person
	~		|

total Average FTE per female=
	SUM(Female FTE per age[female all!]*Female population[female all!])/SUM(Female population\
		[female all!])
	~	FTE/person
	~		|

"M Policy 5: Migration ouflow male"[male all]=
	IF THEN ELSE(Total labour balance>=0, ((Total labour balance/total Average FTE per male\
		)*labour balance on migration coefficient)*lookup factors net migration per age male
	(male age groups[male all])/delay factor adapting migration policy , 0 )
	~	person/(Year*Year)
	~		|

"M Policy 5: Migration inflow male"[male all]=
	IF THEN ELSE(Total labour balance<0, ((-Total labour balance/total Average FTE per male\
		)*labour balance on migration coefficient)*lookup factors net migration per age male
	(male age groups[male all])/delay factor adapting migration policy
	 , 0 )
	~	person/(Year*Year)
	~		|

male working pop previous cohort:
	(mage15-mage94)  -> male working pop all but youngest
	~	
	~		|

