increase in RT Policy 1=
	IF THEN ELSE(Time<2031, "already determind retirement age 2020-2030"*yearly trigger \
		, IF THEN ELSE("RT Policy 1: ASAP to 75 Stock"
	<max retirement age, "3 months per year"*yearly trigger , 0 ) )
	~	Dmnl
	~		|

Scenario Switch Healthcare scenario's=
	1
	~	Dmnl
	~	1 = peek at age of 95.
		2 = peek at age of 80.
	|

total weighed male deaths=
	SUM(weighed male deahts per age[male all!])
	~	person
	~		|

weighed female deahts per age[female all]=
	female deaths[female all]*female age groups[female all]
	~	person
	~		|

male life epectancy=
	total weighed male deaths/total male deaths per year
	~	Year
	~		|

increase in RT policy 2=
	IF THEN ELSE(Time<2031, "already determind retirement age 2020-2030"*yearly trigger \
		,
	IF THEN ELSE("RT Policy 2: ASAP to 75 with 6 months increase Stock"<max retirement age\
		, "6 months per year"*yearly trigger
	 , 0 ) )
	~	Dmnl
	~		|

female life expectancy=
	total weighed female deaths/total female deaths per year
	~	Year
	~		|

total workforce per sector in person[sectors]=
	total female workforce per sector[sectors]+total male workforce per sector[sectors]
	~	person
	~		|

female Unemployment rate=
	(total female available workforce-total female workforce)/total female available workforce
	~	Dmnl
	~		|

Influence of Healthcare level on death rate 2(
	[(0,0)-(125,0.2)],(0,0),(50,0),(80,0.1),(110,0),(125,0))
	~	1/Year
	~		|

total weighed female deaths=
	SUM(weighed female deahts per age[female all!])
	~	person
	~		|

female death rate per age[female all]=
	IF THEN ELSE(Scenario Switch Healthcare scenario's=1, female lookup mortality rate(female age groups\
		[female all])-Healthcare level
	*Influence of Healthcare level on death rate 1
	(female age groups
	[female all]) , female lookup mortality rate(female age groups[female all])-Healthcare level
	*Influence of Healthcare level on death rate 2
	(female age groups
	[female all]) )
	~	1/Year
	~		|

weighed male deahts per age[male all]=
	male deaths[male all]*male age groups[male all]
	~	person
	~		|

test firing=
	IF THEN ELSE( test delta difference>1 , test workforce/test time working at same job\
		 , (test total workforce-test labour demand)/test delay of firing when there is labour surplus
	)
	~	1/Year
	~		|

increase in RT policy 3=
	IF THEN ELSE(Time<2031, "already determind retirement age 2020-2030"*yearly trigger \
		, IF THEN ELSE(target age Kunduz proposal
	>"RT Policy 3: Kunduz proposal Stock", IF THEN ELSE(target age Kunduz proposal-"RT Policy 3: Kunduz proposal Stock"
	>"3 months per year", "3 months per year"*yearly trigger , 0
	 ) , 0 ) )
	~	Dmnl
	~		|

increase in RT policy 4=
	IF THEN ELSE(Time<2031, "already determind retirement age 2020-2030"*yearly trigger \
		, IF THEN ELSE(target age Kunduz proposal
	>="RT Policy 4: Kunduz proposal with 6 months increase Stock", IF THEN ELSE(target age Kunduz proposal
	-"RT Policy 4: Kunduz proposal with 6 months increase Stock"
	>"6 months per year", "6 months per year"*yearly trigger , 0
	 ) , 0 ) )
	~	Dmnl
	~		|

test delay of firing when there is labour surplus=
	1
	~	Year
	~		|

"6 months per year"=
	0.5
	~	Year
	~		|

"3 months per year"=
	0.25
	~	Year
	~		|

"M Policy 5: Migration ouflow female"[female all]=
	IF THEN ELSE(Total labour balance>=0, ((Total labour balance/total Average FTE per female\
		)*labour balance on migration coefficient)*lookup factors net migration per age female
	(female age groups[female all])/delay factor adapting migration policy
	 , 0 )
	~	person/(Year*Year)
	~		|

"M Policy 5: Migration inflow female"[female all]=
	IF THEN ELSE(Total labour balance<0, ((-Total labour balance/total Average FTE per female\
		)*labour balance on migration coefficient)*lookup factors net migration per age female
	(female age groups[female all])/delay factor adapting migration policy
	 , 0 )
	~	person/(Year*Year)
	~		|

Wages in Industry[s industry]=
	Wages[s industry]
	~	Euro/(FTE*Month)
	~		|

increase in capital[s industry]=
	exogenous trend in capital+(increase in wages[s industry]/Wages in Industry[s industry\
		])*Wages on capital coefficient
	~	1/Year
	~		|

Wages in Service[s service]=
	Wages[s service]
	~	Euro/(FTE*Month)
	~		|

increase in technology[s industry]=
	exogenous trend in technology+(increase in wages[s industry]/Wages in Industry[s industry\
		])*Wages on technology coefficient
	~	1/Year
	~		|

decrease female FTE per age[female all]=
	IF THEN ELSE(average wages>wages threshold for decreasing FTE per worker, IF THEN ELSE\
		 (female working age boolean[female all
	] = 1 , ( Female FTE per age
	[female all] - minimum FTE per age
	) * annual change in FTE per age due to higher wages*difference between average wages and wages threshold for FTE per worker
	, ( Female FTE per age
	[female all] - minimum FTE per age
	) * annual change in FTE per age due to higher wages*factor extra change in FTE per age if retired\
		*difference between average wages and wages threshold for FTE per worker
	 ),0 )
	~	FTE/(Year*person)
	~		|

average wages=
	SUM(Wages[sectors!])/2
	~	Euro/(FTE*Month)
	~		|

difference between average wages and wages threshold for FTE per worker=
	MAX(1, (average wages-wages threshold for decreasing FTE per worker)/wages threshold for decreasing FTE per worker\
		)
	~	Dmnl
	~		|

difference between average wages and wages threshold for labour participation=
	MAX(1, (average wages-wages threshold for decreasing labour participation)/wages threshold for decreasing labour participation\
		)
	~	Dmnl
	~		|

Decrease in Male Labour Participation[male all]=
	IF THEN ELSE(average wages>wages threshold for decreasing labour participation, IF THEN ELSE\
		 (male working age boolean
	[male all] = 1 , ( Male Labour Participation per age
	[male all] - minimum Labour Participation
	) * annual change in labour participation due to higher wages*difference between average wages and wages threshold for labour participation
	, ( Male Labour Participation per age[male all] - minimum Labour Participation
	) * annual change in labour participation due to higher wages*factor extra change in labour participation if retired\
		*difference between average wages and wages threshold for labour participation
	 ),
	0 )
	~	1/Year
	~		|

Decrease in Female Labour Participation[female all]=
	IF THEN ELSE(average wages>wages threshold for decreasing labour participation, IF THEN ELSE\
		 (female working age boolean
	[female all] = 1 , ( Female Labour Participation per age
	[female all] - minimum Labour Participation
	) * annual change in labour participation due to higher wages*difference between average wages and wages threshold for labour participation
	, ( Female Labour Participation per age[female all] - minimum Labour Participation
	) * annual change in labour participation due to higher wages*factor extra change in labour participation if retired\
		*difference between average wages and wages threshold for labour participation
	 ),
	0 )
	~	1/Year
	~		|

decrease in male FTE per age[male all]=
	IF THEN ELSE(average wages>wages threshold for decreasing FTE per worker, IF THEN ELSE\
		 (male working age boolean[male all
	] = 1 , ( Male FTE per age
	[male all] - minimum FTE per age
	) * annual change in FTE per age due to higher wages*difference between average wages and wages threshold for FTE per worker
	, ( Male FTE per age
	[male all] - minimum FTE per age
	) * annual change in FTE per age due to higher wages*factor extra change in FTE per age if retired\
